# kaslhi_sports.env — config for the Kalshi sports bot
# This bot is fully independent of the project root .env: non-secret config lives
# here (tracked); Kalshi credentials live in kaslhi_sports_secrets.env (gitignored —
# see kaslhi_sports_secrets.env.example to set it up).
# SPORTS_PLATFORM=kalshi_sports_v1   # read by bot_sports.py; only value supported today

# Comma-separated sports (case-insensitive; matched against Kalshi series tags).
SPORTS_LIST=tennis
# Minimum estimated USD volume (contracts x last_price) for a market to qualify.
# 0 = include ALL live matches (Wimbledon qualifying etc. are only ~$10k volume,
# so a high floor like 49999 was filtering them out). Raise this to focus on
# higher-volume matches if there are too many to poll.
MIN_VOLUME_USD=5000
# Max live matches kept per sport (highest-volume first). High = include them all.
TOP_N_PER_SPORT=100

# ── Order / polling knobs (defaults shown; uncomment to override) ──
SPORT_CONTRACTS=100             # contracts per order
SPORT_SELL=FALSE
SPORT_TARGET_PCT=30           # TP sell at +% over buy (alias: SPORT_TRGATE_PCT)
                              # NOTE: 06/25 settlement backtest validated 40% (71% win,
                              # $1.70 avg) vs 20% (59% win, $0.82 avg) as the better of
                              # those two — 60% has not been backtested against the band/
                              # model changes since. Kept at user's explicit 60 (this
                              # local override); revisit with fresh settlement data.
SPORT_BID_LO=15               # STEP 1 discovery band (low cents)
SPORT_BID_HI=85               # STEP 1 discovery band (high cents)
# SPORT_DECIDED_BID=90          # drop a match once the leader's bid exceeds this
# SPORT_POLL_S=10               # re-poll each match every N seconds
# SPORT_POST_ORDER_DELAY_S=10   # pause after placing an order
# SPORT_FILL_TIMEOUT_S=900      # max wait for fill (15 min)
# SPORT_FILL_POLL_S=60          # poll the order fill every N seconds (lower = more API calls)
# SPORT_CLOSE_TIMEOUT_S=14400   # max wait for the position to close
# SPORT_LIST_REFRESH_S=300      # supervisor wakes every N s to spawn promoted watchers
# SPORT_MAIN_REFRESH_S=3600     # STRICT full re-discovery of the active (main) list (60 min)
# SPORT_PENDING_REFRESH_S=1800  # promote not-started matches to the main list (30 min, no API)
# SPORT_MAX_CONCURRENCY=12      # concurrent eval API calls (lower this if you still see 429s)
# SPORT_PLACE_ORDERS=TRUE       # FALSE = print signals only (no orders)
# SPORT_LOG_DIR=.               # folder for kalshi_sports_YYYYMMDD.log (archived on day change)

# ── Portfolio profit-target halt (PV = cash+positions at start, checked every 30 min) ──
# When PV (cash + open positions) grows by TARGET_PORTFOLIO_PCT (eg start $100 + 100 →
# target $200) the bot STOPS opening new buys, keeps managing the positions it bought
# this session until they all close, and only THEN halts (+ shuts down when HALT_MACHINE_SHUTDOWN).
 TARGET_PORTFOLIO_PCT=0       # 0 / unset disables the target halt. Account-wide halts are OFF here (user 07/30): the Kalshi account is shared, so a joint-PV target let one bot stop the others. Risk is per bot, on its own bankroll.
# SPORT_PV_CHECK_S=1800         # cash re-check interval (seconds; default 30 min)
# SPORT_DRAIN_POLL_S=60         # how often to re-check open positions while draining
# SPORT_DRAIN_TIMEOUT_S=3600    # max wait for positions to close before halting (default 60 min); 0 = forever
 HALT_MACHINE_SHUTDOWN=FALSE    # TRUE = shut the PC down on halt; FALSE = just stop the bot
DRY_RUN_MODE=FALSE            # FALSE = live trading (code default is TRUE if unset — keep explicit)
#   (TARGET_PORTFOLIO_PCT / HALT_MACHINE_SHUTDOWN may also live in the root .env,
#    which the BTC/perp bots already read.)
#
# NOTE: this file is tracked in git — do NOT put API keys / secrets here.

# Band raised 40→68 (06/28 settlement study): old 40-82 lost -$137 under TP+40%;
# cheap bids in efficient ITF markets are coin-flips. Edge is only at bid>=~68c (80% win).
# NOTE: PREDICT_BID_LO/HI feed every tennis model EXCEPT v5, whose 50-62c
# band is HARD-CODED in predict_v5.py and ignores these keys entirely.
# That now includes the MAIN bot whenever an operator picks a non-default
# model from the desk, not just the standalone v1 bot.
#
# This was 40 while the comment above said 68 - the value predict_v5.py's
# header names as the leak that silently re-opened the closed 40-67c
# coin-flip band (-$1,652 on 60-79c entries alone). Restored to the
# study's number. Do not lower it without a new settlement study.
PREDICT_BID_LO=68
PREDICT_BID_HI=84
SPORT_INSUFFICIENT_PAUSE_S=1000
PREDICT_ULTRA_MAX=85
# Set-2 gate: a BUY signal during set 2 (3rd set not started) only executes when the
# bid is BELOW this; until then the signal returns WAIT and the watcher keeps polling.
PREDICT_SET2_MAX_BID=56
# Stop-loss disabled per user request 07/06 (mid-review of a losing morning) — 0
# disables the whole stop-loss pass in _tp_guardian.
SPORT_STOP_LOSS_C=0
# Reversal-flip also disabled per user request 07/06 — nothing sells a position
# early now except a TP fill or natural settlement.
SPORT_REVERSAL_FLIP=FALSE
SPORT_REBUY=FALSE
# Finals TP (user rule 07/12): matches whose tournament label contains "final"
# ALWAYS get a TP sell at +this %% over entry, even with SPORT_SELL=FALSE.
SPORT_FINAL_TP_PCT=20

# ── MAIN multi-sport bot (bot_kalshi_main.py — merges v1 tennis + v2 baseball) ──
# Sports the MAIN bot runs (each needs an adapter in sport_adapters/; falls back
# to SPORTS_LIST above if unset). Adding a sport later = new adapter file + a
# registry line + a block of <SPORT>_* knobs here — the engine doesn't change.
# PAPER TRADING (user 07/17): MAIN_PAPER=TRUE simulates every order against
# the live book (resting-limit fills, real exit policy, taker fees,
# settlement at 100/0) — NO real orders; results in paper_trades_main.csv
# with its own match ledger. Set FALSE to go live again.
MAIN_PAPER=TRUE
# MAIN_PAPER_POLL_S=15        # paper fill/exit simulation cadence
MAIN_SPORTS_LIST=tennis,baseball
#MAIN_SPORTS_LIST=tennis
# PIPELINE sports: adapter + STUB prediction model exist (structure validated at
# every startup, never discovered/traded). To ACTIVATE one: implement its model
# in prediction-trade/sports/<sport>/prediction_<sport>_v1.py (delete IS_STUB),
# move the sport into MAIN_SPORTS_LIST, and set its <SPORT>_BANK / _CONTRACTS /
# _STOP_LOSS_PCT below. Golf will also need a discovery override (outrights).
MAIN_SPORTS_LIST_TBD=basketball,soccer,cricket,hockey,golf
# Per-sport risk (UPPER or lower case keys both work, e.g. tennis_bank=100):
#   <SPORT>_BANK           session bankroll ($) for that sport; 0 = unlimited.
#                          New buys must also FIT in what's left of the bank.
#   <SPORT>_CONTRACTS      contracts per order for that sport
#                          (falls back to SPORT_CONTRACTS above).
#   <SPORT>_STOP_LOSS_PCT  once the sport's realized session loss exceeds this %
#                          of its bank, THAT sport's betting STOPS with a banner
#                          (open positions stay managed; other sports continue).
#   <SPORT>_STOP_LOSS_C    per-position stop, cents under entry (0 = disabled).
#   <SPORT>_POLL_S / <SPORT>_MAX_LIVE_HOURS  per-sport polling/staleness.
# Prediction-model knobs stay per model: PREDICT_* (tennis) / BASEBALL_* below.
# Spread gate (user rule 07/12): before EVERY order (buy / TP sell / stop-loss /
# band exit) — if the bid/ask spread is wider than this many cents, WAIT for a
# stable book (spread back inside the max + two consecutive identical quotes),
# then RE-VALIDATE the buy signal / exit condition and only act if it still
# holds. Never-stable books abandon the buy / defer the exit to the next cycle.
SPORT_SPREAD_MAX_C=3
# SPORT_SPREAD_WAIT_S=10        # re-quote cadence while waiting for stability
# SPORT_SPREAD_TIMEOUT_S=120    # max wait before abandoning/deferring the action
# Hard order-safety rules (user rule 07/12), enforced in main + v2:
#   NEVER BUY NO — only YES-side entries ever (the other participant is backed
#   by buying YES on THEIR market; single-market events' NO side is untradeable).
#   NEVER SELL NAKED — every sell (TP / stop-loss / band exit) first confirms an
#   open position on that exact market SPORT_SELL_CONFIRMS times, with
#   positions AND resting orders re-fetched every round, 5 seconds apart.
SPORT_SELL_CONFIRMS=3
SPORT_SELL_CONFIRM_DELAY_S=5
# ── Tennis model v5 (MAIN bot; user 07/16) ────────────────────────────────────
# Forensics-derived whitelist from ALL 554 bot trades with TRUE P&L rebuilt
# from the Kalshi fills/settlements API (CSVs had +$6,536 phantom vs -$1,539
# real). Verified on a 60/40 time split: train +$201/64 kept, holdout +$61/17
# kept @30% ROI, vs baseline -$1,486. ENTRY: 50-62c price band (HARD-CODED in
# predict_v5.py — no env override; an env override once silently re-opened the
# 40-67c coin-flip band), whitelist F1 (50-59c non-A/E), F2 (fallback),
# F3 (ITF-M mornings), F4 (WTA plain-high), ghost-double-break guard, flat
# sizing (never ultra). F2/F4/Bfav-ITF are PROVISIONAL (tagged in reasons;
# re-validate after ~30 live occurrences each).
# v5 EXECUTION (this block): maker-first entries, one-entry-per-match ledger
# (persistent; also see MAIN_MATCH_LEDGER), resting 97c TP always, entry-20c
# ONE-strike stop that the spread guard never defers, 30c gapped-through
# floor, flat 20 contracts, API-reconciled dollar brakes.
TENNIS_PRICE_BUMP_C=0         # maker-first: rest AT the bid, never cross +5c
                              # (taker bump+spread+fees = $958 = 62% of the loss)
TENNIS_FILL_TIMEOUT_S=60      # unfilled after 60s -> cancel; never chase
TENNIS_TP_CEILING_C=97        # resting TP target + profit-lock ceiling
TENNIS_STOP_LOSS_C=20         # entry-relative stop: exit at bid <= entry-20c
TENNIS_STOP_CONFIRM=1         # ONE strike — no "breach 1/2, watching" delay
TENNIS_SL_FLOOR_C=30          # gapped-through backstop: never hold below 30c
TENNIS_DAY_LOSS_HALT_USD=150   # realized day loss (from the API, not internal
                              # P&L) <= -$60 -> no new tennis entries till 9am
TENNIS_WEEK_LOSS_HALT_USD=150 # trailing 7d <= -$150 -> halt pending review
TENNIS_FIRESELL_EXITS=FALSE   # keep the v3 favorite-based firesells OFF
TENNIS_BANK=300
TENNIS_CONTRACTS=50
TENNIS_STOP_LOSS_PCT=50
BASEBALL_BANK=100
BASEBALL_CONTRACTS=10
BASEBALL_STOP_LOSS_PCT=50
# Pipeline sports — uncomment + tune when activating (models are stubs today).
# Their model knobs (<SPORT>_BID_LO/HI, _MIN_EDGE_C, _TARGET_PCT, _STOP_LOSS_C)
# are read by prediction_<sport>_v1.py with safe defaults.
# BASKETBALL_BANK=100
# BASKETBALL_CONTRACTS=20
# BASKETBALL_STOP_LOSS_PCT=50
# CRICKET_BANK=100
# CRICKET_CONTRACTS=20
# CRICKET_STOP_LOSS_PCT=50
# HOCKEY_BANK=100
# HOCKEY_CONTRACTS=20
# HOCKEY_STOP_LOSS_PCT=50
# SOCCER_BANK=100
# SOCCER_CONTRACTS=20
# SOCCER_STOP_LOSS_PCT=50
# GOLF_BANK=100
# GOLF_CONTRACTS=20
# GOLF_STOP_LOSS_PCT=50
# MAIN_TRADE_CSV=...            # default <customer>/trade_history/trade_history_main.csv

# ── PARLEY bot (bot_kalshi_parley.py) ─────────────────────────────────────────
# Combines several LIVE matches into ONE Kalshi multivariate-collection market
# (resolves YES only if every leg wins) and buys it with a MARKET order.
# A match becomes a leg only when: it is genuinely in play (Kalshi market
# status + adapter confirmation + milestone live flag — postponed/delayed/
# cancelled/finished/not-started never qualify), it is AT LEAST in set
# PARLEY_MIN_SET, one participant's YES price is strictly ABOVE
# PARLEY_MIN_PROB_C, and THAT participant is leading the set.
PARLEY_SPORTS_LIST=tennis     # sports to scan (same names as MAIN_SPORTS_LIST)
PARLEY_MIN_PROB_C=80          # a leg needs a YES price > this (i.e. "odds >80%")
PARLEY_MIN_SET=2              # match must be at least in this set
PARLEY_LEAD_SCOPE=current     # which set the >80% player must LEAD:
                              #   current = the set in progress (>= MIN_SET)
                              #   second  = always set 2 specifically
                              #   off     = price only, no lead requirement
PARLEY_MIN_LEGS=2             # fewer qualifying legs than this → no parlay
                              # (2 is also the exchange's own collection minimum)
PARLEY_MAX_LEGS=0             # 0 = take EVERY qualifying live match
PARLEY_MIN_VOLUME_USD=5000    # per-leg liquidity floor (as MIN_VOLUME_USD above)
# Execution — the V2 order API has NO market-order type, so a market order is
# sent as a MARKETABLE immediate-or-cancel: it sweeps the book at ask+slippage
# (capped at MAX_PRICE_C) and cancels the remainder instead of resting.
PARLEY_SLIPPAGE_C=3           # cents crossed above the ask
PARLEY_MAX_PRICE_C=95         # never pay more than this per combo contract
PARLEY_MIN_PRICE_C=2          # a combo cheaper than this is noise — skip
# A NEWLY CREATED COMBO HAS AN EMPTY BOOK (verified live 08/14: status=active,
# orderbook {} — nothing quotes it), so a market order fills 0 and the bot
# safely takes no position. TRUE instead rests a GTC maker buy at the
# theoretical price (product of the legs + slippage) for PARLEY_FILL_WAIT_S,
# then cancels if nobody takes it.
PARLEY_LIMIT_FALLBACK=FALSE
# PARLEY_FILL_WAIT_S=30       # how long to wait for the entry to fill
PARLEY_MAX_OPEN=1             # concurrent open parlays
PARLEY_COOLDOWN_S=900         # minimum gap between two parlays
PARLEY_SCAN_S=60              # rescan cadence
PARLEY_GUARD_S=120            # guardian (TP upkeep / stop / floor) cadence
# PARLEY_COLLECTION=          # pin one collection ticker; blank = auto-pick the
#                             # open collection that hosts every leg's event
# Risk — SAME mechanism/keys as the per-sport banks above (SportConfig/SportBook)
PARLEY_BANK=100               # session bankroll ($); 0 = unlimited
PARLEY_CONTRACTS=10           # contracts per parlay order
PARLEY_STOP_LOSS_PCT=50       # realized session loss >= this % of bank → HALT
PARLEY_TP_CEILING_C=97        # resting take-profit sell + profit-lock ceiling
PARLEY_STOP_LOSS_C=20         # entry-relative stop: exit at bid <= entry-20c
PARLEY_STOP_CONFIRM=1         # breach cycles before the stop fires (1 = one strike)
PARLEY_SL_FLOOR_C=15          # hard floor — never hold a combo below this
PARLEY_DAY_LOSS_HALT_USD=60   # API-reconciled (fills+settlements) day brake
PARLEY_WEEK_LOSS_HALT_USD=150 # trailing 7d brake → halt pending review
# PARLEY_PAPER=TRUE           # full pipeline vs the live book, NO real order
# PARLEY_PAPER_CREATE_MARKET=FALSE  # paper: price the combo theoretically instead
#                             # of creating a real combined market (creations are
#                             # capped by Kalshi at 5000/week)
# PARLEY_PLACE_ORDERS=FALSE   # print the parlay it WOULD buy, place nothing
# PARLEY_TRADE_CSV=...        # default <customer>/trade_history/trade_history_parley.csv

# ── Baseball bot v2 (bot_kalshi_sports_v2.py + sports/baseball/prediction_baseball_v1.py) ──
# v2 trades ONLY baseball (MLB/NPB/KBO); discovery reuses MIN_VOLUME_USD,
# TOP_N_PER_SPORT and SPORT_BID_LO/HI above. Defaults shown; uncomment to override.
BASEBALL_SCALP_PCT=10         # scalp exit: TP sell at +this % over entry (>= 10% net)
BASEBALL_BID_LO=30            # model ENTRY band (cents) — needs +10% headroom to 98c
BASEBALL_BID_HI=84
BASEBALL_MIN_EDGE_C=6         # min model-vs-market edge (model WP*100 - live bid, cents)
BASEBALL_ULTRA_EDGE_C=14      # edge >= this AND inning >= 6 → ultra-high (1.5x size)
BASEBALL_MIN_INNING=3         # never enter before this inning (early lines are efficient)
BASEBALL_STOP_LOSS_C=18       # guardian stop: exit once bid <= entry - this (0 disables)
BASEBALL_SELL=TRUE            # the scalp TP sell IS the strategy — keep TRUE
# Score-flip exit (user rule 07/12): while HOLDING, if the bought team LOSES a
# lead and falls BEHIND on runs (e.g. led 2-0, now trails 2-3) → cancel the
# resting TP and fire an exit sell immediately (main bot + v2; ties never fire,
# a team never seen leading never fires — that case is the stop-loss's job).
BASEBALL_SCORE_FLIP_EXIT=TRUE
# sports4cast gate (user rule 07/12): baseball_data.csv is scraped from
# sports4cast.com/4casts/baseball4cast/ at startup (if stale) and DAILY at
# 8:15 AM CST; a BUY only executes when the team has >= this win % there.
BASEBALL_4CAST_MIN_PCT=51
# BASEBALL_4CAST_REQUIRE=FALSE  # TRUE = also block teams NOT in the data
#                               # (feed is MLB-only; NPB/LMB would never trade)
# BASEBALL_4CAST_HOUR=8         # daily scrape time (CST)
# BASEBALL_4CAST_MINUTE=15
# BASEBALL_4CAST_CSV=...        # default sports/baseball/baseball_data.csv
# Launch freshness (user 07/13): at every bot_kalshi_main launch the CSV is
# re-scraped unless it was already updated TODAY (CST) — first launch each day
# refreshes; later same-day launches skip. Tennis rankings follow the same
# "scraped today?" rule (see SPORT_SCRAPE_RANKINGS / SPORT_RANK_MAX_AGE_H).
# BASEBALL_CONTRACTS=20      # contracts per order (default: SPORT_CONTRACTS above)
# BASEBALL_POLL_S=30          # in-play re-poll cadence (seconds)
# BASEBALL_MAX_LIVE_HOURS=6   # drop a game live longer than this (extras/delays)
# BASEBALL_HOME_EDGE_RUNS=0.12   # home-field edge in runs over a full remaining game
# BASEBALL_HALF_INN_VAR=0.60     # run-diff variance per half-inning (full-game sigma ~3.3)
# BASEBALL_OVERREACT_FAV_MIN_C=55  # OVERREACTION situation: pre-game favorite >= this …
# BASEBALL_OVERREACT_DROP_C=15     # … marked down at least this many cents live
