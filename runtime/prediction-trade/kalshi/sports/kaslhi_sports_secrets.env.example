# kaslhi_sports_secrets.env.example — template for the sports bot's Kalshi credentials.
#
# Copy this file to kaslhi_sports_secrets.env (same folder) and fill in real values.
# kaslhi_sports_secrets.env is GITIGNORED (matches the blanket *.env rule) — it holds
# real credentials and must never be committed.
#
# This makes bot_sports.py / bot_kalshi_sports_v1.py fully independent of the
# project's root .env: they load kaslhi_sports.env (non-secret config, tracked) +
# kaslhi_sports_secrets.env (credentials, gitignored) and nothing else.

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=kalshi_private.pem

# Not secret, but kept here so this bot has zero dependency on root .env:
BASE_URI=https://external-api.kalshi.com/trade-api/v2
DRY_RUN_MODE=TRUE
HALT_MACHINE_SHUTDOWN=FALSE
