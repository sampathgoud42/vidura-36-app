# bot_best_pair.env -- the best-pairs bot's own settings.
#
# Non-secret, and tracked on purpose: a fresh clone has to know what the bot
# trades. The Tradier key is NOT here -- it is the operator's own credential,
# sealed in the desk's database, and the bot reads it the way the desk does.
# The database, the master key and paper-only come from the project .env,
# shared with the desk so both see the same positions and the same claims.
#
# Any BOT_BEST_PAIR_* variable set in the environment overrides this file.
# Values mirror ARM AUTO TRADE -> strategy "best pairs" on the desk.

# ---- who and where ------------------------------------------------------
# The desk sign-in (operator slug) whose Tradier account this bot trades.
# Required: the bot will not guess whose money to spend.
BOT_BEST_PAIR_OPERATOR=
# false = the Tradier sandbox (paper). true = the real account, which also
# needs TBOT_PAPER_ONLY=false in the project .env.
BOT_BEST_PAIR_LIVE=false

# ---- which pairs --------------------------------------------------------
# The daily report's best ticker + signal pairs (the desk's
# best_ticker_signal_pairs table), filtered by these inclusive minimums.
# Blank or "any" = no minimum. Each pair trades its own signal type on its
# own ticker; every pair that meets them is traded.
BOT_BEST_PAIR_MIN_EDGE=57
BOT_BEST_PAIR_MIN_WIN_PCT=any
BOT_BEST_PAIR_MIN_NET_R=any

# ---- the contract -------------------------------------------------------
# A LONG buys a CALL, a SHORT buys a PUT, the delta closest to the middle of
# this band (signed per side) with a two-sided quote.
BOT_BEST_PAIR_DELTA_MIN=0.25
BOT_BEST_PAIR_DELTA_MAX=0.45
# false = never a same-day contract: the nearest expiry after today.
BOT_BEST_PAIR_ZERO_DTE=false

# ---- exits (both rest at the venue once the buy fills) -----------------
BOT_BEST_PAIR_TP_PCT=10               # take-profit, % over entry
BOT_BEST_PAIR_SL_PCT=30               # stop-loss, % below entry

# ---- sizing -------------------------------------------------------------
BOT_BEST_PAIR_BUY_PCT=40              # % of option buying power per entry
BOT_BEST_PAIR_SIZE_TOLERANCE_PCT=10   # the total may land this far either side
BOT_BEST_PAIR_MIN_CONTRACTS=1         # sized below this, the entry is skipped

# Order type is fixed: smart limit -- the desk's BUY (mid on a wide spread,
# the ask on a tight one).

# ---- when (CST) ---------------------------------------------------------
# A signal must fire live inside this window, at most 6 minutes old and still
# open. One entry per ticker per hour, shared with the desk's own auto-trader.
BOT_BEST_PAIR_WINDOW_OPEN=08:30
BOT_BEST_PAIR_WINDOW_CLOSE=14:30

# ---- stops --------------------------------------------------------------
# Exits are armed by the risk monitor after the fill. auto = the desk's own
# monitor does it while the desk runs, and this bot sweeps this operator's
# positions itself whenever the desk is down. off = leave it to the desk
# (entries are then refused while the desk is down).
BOT_BEST_PAIR_OWN_MONITOR=auto
# Where the desk answers /readiness. Blank = http://127.0.0.1:<TBOT_PORT or 8791>.
BOT_BEST_PAIR_DESK_URL=
