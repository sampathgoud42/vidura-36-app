# Tradier Bot — machine configuration template.
# Copy to .env in this folder and edit. EVERY value is optional: the code
# defaults are project-relative and paper-safe, so a fresh copy of this
# folder runs on any machine with nothing configured.
#
# Every field in backend/app/core/config.py maps to TBOT_<FIELD_NAME>.
# The old VIDURA_* names are still accepted (see _bridge_legacy_env).

# --- paths (defaults are all inside this project; override only to move
# --- state onto another disk) -----------------------------------------
#TBOT_DATABASE_PATH=D:/_projects/vidura-36-app/var/app.db
#TBOT_CUSTOMERS_ROOT=D:/_projects/vidura-36-app/customers
#TBOT_SOURCE_REPO=D:/_projects/vidura-36-app/runtime
#TBOT_LEVELS_DIR=D:/_projects/vidura-36-app/runtime/stock-trade

# Interpreter for the vendored engines (super_signal_bot.py,
# levels_watcher.py). Default: this API's own venv, which requirements.txt
# already equips with numpy/pandas/yfinance. Point elsewhere only if you
# keep those deps in a separate install.
#TBOT_SUPER_PYTHON=C:/Users/you/AppData/Local/Programs/Python/Python312/python.exe

# Interpreter for the Bot Station's Kalshi bot subprocesses. Default: this
# API's own venv, which requirements.txt equips with requests, cryptography
# and aiohttp — everything those scripts import.
#TBOT_BOT_PYTHON=C:/Users/you/AppData/Local/Programs/Python/Python312/python.exe

# --- SAFETY ------------------------------------------------------------
# Paper-only is the CODE default, so a fresh copy can never place a real
# order by surprise. Every client is pinned to Tradier's sandbox venue —
# its own token, its own account. Uncomment ONLY on a machine that is meant
# to trade real money.
#TBOT_PAPER_ONLY=false

# --- sign-in -----------------------------------------------------------
# ON by default. The desk asks for a password before it renders, and every
# /api call must then carry the session token it returns. The password is
# the operator's own customers/<username>/.sam - nothing to configure here.
# Turn this off ONLY for a throwaway localhost session: this desk can place
# real options orders and binds 0.0.0.0.
#TBOT_LOGIN_REQUIRED=false

# How long a sign-in lasts. Sessions are in-memory regardless, so any
# restart of the API signs everyone out. Default 43200 (12h).
#TBOT_SESSION_TTL_S=43200

# A fixed key for scripts and cron, which cannot type a password. Sent in
# the same X-API-Key header as a session token, and never expires.
#TBOT_API_KEY=change-me

# --- Tradier desk ------------------------------------------------------
#TBOT_TRADIER_AUTO_TICKERS=SPY,QQQ,SPX
#TBOT_TRADIER_AUTO_WINDOW_OPEN=08:30
#TBOT_TRADIER_AUTO_WINDOW_CLOSE=09:30
#TBOT_TRADIER_TP_PCT=15
#TBOT_TRADIER_SL_PCT=30
#TBOT_TRADIER_BUY_PCT=50
#TBOT_TRADIER_MONITOR_INTERVAL_S=10

# --- optional integrations --------------------------------------------
# flashAlpha GEX. FREE plan = 5 requests/day TOTAL; the daily 09:00 CST
# snapshot spends them. Without a key the GEX panels simply stay empty.
#TBOT_FLASHALPHA_API_KEY=
#TBOT_GEX_DAILY_ENABLED=false

# Background signal ingest + the keyless earnings sweep. Turn both off on an
# air-gapped host, where every pass would only log a failure.
#TBOT_SUPER_AUTO_SYNC=false
#TBOT_EARNINGS_ENABLED=false

# --- Bot Station -------------------------------------------------------
# Hourly (and half-hourly) sweeps that settle ledger rows the exchange has
# finished but the bot never closed, from Kalshi fills + settlements. Reads
# only, and never touches a ticker that is still an active position. Turn it
# off on a host with no Kalshi credentials, where every pass just fails.
#TBOT_RECONCILE_ENABLED=false
#TBOT_RECONCILE_INTERVAL_S=3600
#TBOT_RECONCILE_STALE_HOURS=24
#TBOT_RECONCILE_FAST_INTERVAL_S=1800
#TBOT_RECONCILE_FAST_STALE_MINUTES=30

# Mirror the bots' trade CSVs into SQLite before answering a read, so an
# open position appears without anyone pressing "sync". Disable only if the
# CSVs live somewhere the API cannot read.
#TBOT_TRADES_AUTO_SYNC=false

# Postgres instead of SQLite (cloud): overrides TBOT_DATABASE_PATH
#TBOT_DATABASE_URL_OVERRIDE=postgresql+psycopg://user:pw@host/db

# --- vendor data keys --------------------------------------------------
# API Ninjas commodity prices, used by hot_scan when the equity venue is
# closed. Application-level vendor key, NOT per-customer. Empty = the
# commodity price lookup returns nothing (it degrades, it does not crash).
TBOT_APININJAS_API_KEY=your_api_ninjas_key_here

# --- tenant credential encryption (REQUIRED once customers are in the DB) ---
# Wraps the per-record data key that seals each customer's venue credentials.
# Generate one per environment and never reuse across environments:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# LOSING THIS KEY MAKES EVERY STORED CREDENTIAL UNRECOVERABLE. There is no
# recovery path. Back it up where you back up nothing else.
TBOT_ENCRYPTION_MASTER_KEY=generate_your_own_do_not_use_this_value
# Bump when re-keying; old keys stay readable as TBOT_ENCRYPTION_MASTER_KEY_V1 etc.
#TBOT_ENCRYPTION_KEY_VERSION=1
